      { "name": "last_agent_reply_at", "type": "dateTime", "options": { "timeZone": "utc", "dateFormat": { "name": "iso" }, "timeFormat": { "name": "24hour" } } },
      { "name": "cancel_ask_appt_id", "type": "singleLineText" },
      { "name": "marketing_consent", "type": "checkbox", "options": { "icon": "check", "color": "greenBright" } }
    ]},
    { "name": "Appointments", "fields": [
      { "name": "appt_id", "type": "singleLineText" },
      { "name": "client_id", "type": "singleLineText" },
      { "name": "service_id", "type": "singleLineText" },
