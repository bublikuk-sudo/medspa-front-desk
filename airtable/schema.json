      { "name": "name", "type": "singleLineText" },
      { "name": "duration_min", "type": "number", "options": { "precision": 0 } },
      { "name": "price", "type": "currency", "options": { "precision": 2, "symbol": "$" } },
      { "name": "deposit_required", "type": "checkbox", "options": { "icon": "check", "color": "greenBright" } },
      { "name": "active", "type": "checkbox", "options": { "icon": "check", "color": "greenBright" } }
    ]},
    { "name": "Clients", "fields": [
