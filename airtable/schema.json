      { "name": "working_hours", "type": "multilineText" },
      { "name": "calendar_id", "type": "singleLineText" },
      { "name": "owner_contact", "type": "singleLineText" },
      { "name": "whatsapp_number", "type": "singleLineText" },
      { "name": "intake_form_url", "type": "url" },
      { "name": "cancellation_hours", "type": "number", "options": { "precision": 0 } },
      { "name": "reminder_hours_before", "type": "number", "options": { "precision": 0 } },
