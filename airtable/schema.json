    { "name": "Knowledge", "fields": [
      { "name": "kb_id", "type": "singleLineText" },
      { "name": "topic", "type": "singleLineText" },
      { "name": "text", "type": "multilineText" },
      { "name": "updated_at", "type": "lastModifiedTime", "options": { "referencedFieldIds": [] } }
    ]}
  ],
  "links": [
    { "table": "Appointments", "field": "client",  "to": "Clients" },
    { "table": "Appointments", "field": "service", "to": "Services" }
  ]
}
