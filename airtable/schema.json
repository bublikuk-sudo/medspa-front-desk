      { "name": "reminder_sent_at", "type": "dateTime", "options": { "timeZone": "utc", "dateFormat": { "name": "iso" }, "timeFormat": { "name": "24hour" } } },
      { "name": "confirmed_at", "type": "dateTime", "options": { "timeZone": "utc", "dateFormat": { "name": "iso" }, "timeFormat": { "name": "24hour" } } },
      { "name": "revisit_invited_at", "type": "dateTime", "options": { "timeZone": "utc", "dateFormat": { "name": "iso" }, "timeFormat": { "name": "24hour" } } },
      { "name": "replaces_appt_id", "type": "singleLineText" },
      { "name": "cancel_expires_at", "type": "dateTime", "options": { "timeZone": "utc", "dateFormat": { "name": "iso" }, "timeFormat": { "name": "24hour" } } },
      { "name": "treatment_notes", "type": "multilineText" },
      { "name": "next_visit_in", "type": "number", "options": { "precision": 0 } },
      { "name": "practitioner", "type": "singleLineText" }
