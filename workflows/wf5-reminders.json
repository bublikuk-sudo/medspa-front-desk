      "typeVersion": 2.1,
      "position": [0, 500],
      "webhookId": "5a0e0017-aaaa-4c00-8000-00000000f005",
      "credentials": {
        "httpHeaderAuth": { "id": "CRED", "name": "MedSpa Test Key" }
      },
      "parameters": {
        "httpMethod": "POST",
        "path": "wf5-reminders",
        "authentication": "headerAuth",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "5a0e0017-0003-4c00-8000-000000000003",
      "name": "Settings",
      "notes": "One row. An empty or unreadable table makes the next expression throw, so the run fails loudly (-> WF-6) instead of reminding nobody.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 400],
