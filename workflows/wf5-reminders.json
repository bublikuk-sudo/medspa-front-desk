        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "filterByFormula": "AND({status}='pending',IS_BEFORE({pending_expires_at},NOW()),NOT({calendar_event_id}=BLANK()))",
