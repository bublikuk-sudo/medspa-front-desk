      }
    },
    {
      "id": "5a0e0017-0027-4c00-8000-000000000027",
      "name": "Alert Reminder Mark",
      "notes": "Mark Reminded error output: the reminder WAS sent but the row stays booked, so it is sent again next hour.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1760, 20],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const err = j => String((j && (j.message || (j.error && (j.error.message || j.error)))) || 'see WF-6').slice(0, 300);\nconst who = i => { try { return String($('Contact').itemMatching(i).json.appt_id || '?'); } catch (e) { return '?'; } };\nreturn $input.all().map((it, i) => { const a = who(i); return { json: { key: 'reminder-mark:' + a, text: '⚠️ The reminder for ' + a + ' WAS SENT but marking the visit as reminded failed (' + err(it.json) + '). The client may receive the same reminder again every hour until the row is fixed.' } }; });"
      }
    },
    {
      "id": "5a0e0017-0028-4c00-8000-000000000028",
      "name": "Alert Revisit Mark",
