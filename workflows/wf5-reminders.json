    {
      "id": "5a0e0017-0007-4c00-8000-000000000007",
      "name": "Contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 100],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// WhatsApp-created visits go to the client's phone, everything else to Telegram (the client's other channel is the fallback).\n// An empty contact_id is not guessed: send_message throws on it and the failure is reported to the owner.\nconst c = $json.fields || {};\nconst ar = $('Due Reminders').item.json;\nconst a = ar.fields || {};\nconst phone = String(c.phone || '').trim();\nconst chat = String(c.telegram_chat_id || '').trim();\nconst contact_id = (a.created_via === 'wa' && phone) ? 'wa:' + phone : (chat ? 'tg:' + chat : (phone ? 'wa:' + phone : ''));\nreturn { json: { contact_id, appt_id: a.appt_id, rec_id: ar.id } };"
      }
    },
    {
      "id": "5a0e0017-0008-4c00-8000-000000000008",
      "name": "Send Reminder",
      "notes": "Run once for each item, so one bad row fails alone. Error output: a failing row must not stop the hourly run - without it the mark is not set, the same row fails every hour and blocks the later ones.",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [1320, 100],
      "onError": "continueErrorOutput",
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "WFID:send_message", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "contact_id": "={{ $json.contact_id }}",
            "text": "",
            "template_key": "REMINDER",
            "appt_id": "={{ $json.appt_id }}",
            "vars_json": "",
            "outside_window": "true"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "contact_id", "displayName": "contact_id", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "template_key", "displayName": "template_key", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "appt_id", "displayName": "appt_id", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "vars_json", "displayName": "vars_json", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" },
            { "id": "outside_window", "displayName": "outside_window", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
