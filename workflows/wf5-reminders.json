      }
    },
    {
      "id": "5a0e0017-0029-4c00-8000-000000000029",
      "name": "Alert Expiry Mark",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 540],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const err = j => String((j && (j.message || (j.error && (j.error.message || j.error)))) || 'see WF-6').slice(0, 300);\nconst who = i => { try { return String($('Has Appt? 2').itemMatching(i).json.fields?.appt_id || '?'); } catch (e) { return '?'; } };\nreturn $input.all().map((it, i) => { const a = who(i); return { json: { key: 'expiry:' + a, text: '❌ Could not cancel the expired pending booking ' + a + ': ' + err(it.json) } }; });"
      }
    },
    {
      "id": "5a0e0017-0030-4c00-8000-000000000030",
      "name": "Alert Client",
      "notes": "Client (Get) error output. The failed visits are found by comparing the visits (Has Appt?) with the clients that WERE read, NOT by pairing: a Get error item carries no pairedItem. $('Client').all(0) = the success output (the default branch would be the error output this node is connected to).",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const err = j => String((j && (j.message || (j.error && (j.error.message || j.error)))) || 'see WF-6').slice(0, 300);\nconst read = new Set($('Client').all(0).map(i => (i.json || {}).id).filter(Boolean));\nconst e = err($input.first().json);\nconst bad = $('Has Appt?').all(0).map(i => i.json || {}).filter(r => (r.fields || {}).appt_id && !read.has((r.fields.client || [])[0]));\nif (!bad.length) return [{ json: { key: 'client:?', text: '❌ WF-5: a client lookup failed for a reminder but no visit could be matched (' + e + ')' } }];\nreturn bad.map(r => { const c = (r.fields.client || [])[0]; return { json: { key: 'client:' + r.fields.appt_id, text: '❌ WF-5 skipped the reminder of ' + r.fields.appt_id + ': its client record ' + (c || '(no link)') + ' could not be read (' + e + ')' } }; });"
      }
    },
    {
      "id": "5a0e0017-0031-4c00-8000-000000000031",
      "name": "Alert Client 2",
      "notes": "Same as Alert Client, for the revisit rows (Client 2 / Has Appt? 3).",
