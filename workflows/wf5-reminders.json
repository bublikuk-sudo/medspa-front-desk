      }
    },
    {
      "id": "5a0e0017-0032-4c00-8000-000000000032",
      "name": "Dedupe Alerts",
      "notes": "The only way to the owner. At most one alert per key per 24 h, kept in the workflow static data (persisted for production runs - Hourly and Run Now - not for editor test runs). The send/mark itself is still retried every hour; only the alert is throttled.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2000, 500],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst now = Date.now(), DAY = 24 * 3600 * 1000;\nconst seen = sd.alertSeen || {};\nfor (const k of Object.keys(seen)) if (!(now - seen[k] < DAY)) delete seen[k];\nconst out = [];\nfor (const it of $input.all()) {\n  const { key, text } = it.json || {};\n  if (!key || !text || seen[key]) continue;\n  seen[key] = now;\n  out.push({ json: { text, key } });\n}\nsd.alertSeen = seen;\nreturn out;"
      }
    },
    {
      "id": "5a0e0017-0033-4c00-8000-000000000033",
      "name": "Alert Owner",
      "notes": "Nothing is connected to the success output. The error output goes to Forget Alert Keys.",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [2220, 500],
      "onError": "continueErrorOutput",
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "WFID:notify_owner", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
