    {
      "id": "5a0e0017-0016-4c00-8000-000000000016",
      "name": "Orphan Alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 640],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One message listing every expired pending row that still has a calendar event. No such row (the empty item from Always Output Data) -> no item, nothing is sent.\nconst ids = $input.all().map(i => String(((i.json || {}).fields || {}).appt_id || '').trim()).filter(Boolean);\nif (!ids.length) return [];\nconst shown = ids.slice(0, 20).join(', ') + (ids.length > 20 ? ' and ' + (ids.length - 20) + ' more' : '');\nreturn [{ json: { text: '⚠️ ' + ids.length + ' expired pending booking(s) still have a calendar event, so WF-5 did not cancel them: ' + shown + '. Check the calendar and fix the rows by hand.' } }];"
      }
    },
