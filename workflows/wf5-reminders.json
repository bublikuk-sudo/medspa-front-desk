{
  "name": "wf5-reminders",
  "nodes": [
    {
      "id": "5a0e0017-0001-4c00-8000-000000000001",
      "name": "Hourly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [
