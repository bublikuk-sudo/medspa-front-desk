    {
      "id": "5a0e0017-0016-4c00-8000-000000000016",
      "name": "Orphan Alert",
      "notes": "One alert item listing every expired pending row that still has a calendar event; key = 'orphan:' + the SORTED id list, so the same rows are announced once per 24 h by Dedupe Alerts.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [660, 640],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Every expired pending row that still has a calendar event -> ONE alert item. No such row (the empty item from Always Output Data) -> no item, nothing is sent.\nconst ids = $input.all().map(i => String(((i.json || {}).fields || {}).appt_id || '').trim()).filter(Boolean);\nif (!ids.length) return [];\nconst shown = ids.slice(0, 20).join(', ') + (ids.length > 20 ? ' and ' + (ids.length - 20) + ' more' : '');\nreturn [{ json: { key: ('orphan:' + [...ids].sort().join(',')).slice(0, 500), text: '⚠️ ' + ids.length + ' expired pending booking(s) still have a calendar event, so WF-5 did not cancel them: ' + shown + '. Check the calendar and fix the rows by hand.' } }];"
      }
    },
    {
      "id": "5a0e0017-0025-4c00-8000-000000000025",
      "name": "Alert Reminder Send",
      "notes": "Send Reminder error output -> one {key, text} per failed row. The row is found with itemMatching (Execute Workflow sets pairedItem on its error items); a lost pairing gives '?', never a throw.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1540, 200],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const err = j => String((j && (j.message || (j.error && (j.error.message || j.error)))) || 'see WF-6').slice(0, 300);\nconst who = i => { try { return String($('Contact').itemMatching(i).json.appt_id || '?'); } catch (e) { return '?'; } };\nreturn $input.all().map((it, i) => { const a = who(i); return { json: { key: 'reminder-send:' + a, text: '❌ Reminder failed for ' + a + ': ' + err(it.json) } }; });"
      }
    },
    {
