    {
      "id": "5a0e0017-0003-4c00-8000-000000000003",
      "name": "Settings",
      "notes": "One row. An empty or unreadable table makes the next expression throw, so the run fails loudly (-> WF-6) instead of reminding nobody.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 400],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Settings", "mode": "id" },
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "5a0e0017-0004-4c00-8000-000000000004",
      "name": "Due Reminders",
      "notes": "Booked, start inside the next reminder_hours_before hours, and booked at least that many hours ahead: a client who books a visit inside the reminder window is not sent 'Reply YES to confirm' an hour later.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [440, 100],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "filterByFormula": "={{ \"AND({status}='booked',IS_AFTER({start_dt},NOW()),IS_BEFORE({start_dt},DATEADD(NOW(),\" + Number($json.fields.reminder_hours_before) + \",'hours')),DATETIME_DIFF({start_dt},CREATED_TIME(),'hours')>=\" + Number($json.fields.reminder_hours_before) + \")\" }}",
        "returnAll": true,
        "options": {}
      }
    },
