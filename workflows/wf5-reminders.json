    {
      "id": "5a0e0017-0007-4c00-8000-000000000007",
      "name": "Contact",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 100],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// WhatsApp-created visits go to the client's phone, everything else to Telegram (the client's other channel is the fallback).\n// An empty contact_id is not guessed: send_message throws on it and the failure is reported to the owner.\nconst c = $json.fields || {};\nconst ar = $('Due Reminders').item.json;\nconst a = ar.fields || {};\nconst phone = String(c.phone || '').trim();\nconst chat = String(c.telegram_chat_id || '').trim();\nconst contact_id = (a.created_via === 'wa' && phone) ? 'wa:' + phone : (chat ? 'tg:' + chat : (phone ? 'wa:' + phone : ''));\nreturn { json: { contact_id, appt_id: a.appt_id, rec_id: ar.id } };"
      }
    },
