          },
          "matchingColumns": [],
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "each",
        "options": {}
      }
    },
    {
      "id": "5a0e0017-0034-4c00-8000-000000000034",
      "name": "Forget Alert Keys",
      "notes": "Alert Owner error output: notify_owner failed, so the alert never reached the owner. Remove the dedupe keys Dedupe Alerts stamped for it, so it is tried again next hour instead of being silenced for 24 h. Lost pairing -> forget every key of this run. Nothing is connected after it.",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2440, 600],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst seen = sd.alertSeen || {};\nconst keys = $input.all().map((it, i) => { try { return $('Dedupe Alerts').itemMatching(i).json.key; } catch (e) { return undefined; } });\nconst forget = keys.some(k => !k) ? $('Dedupe Alerts').all(0).map(i => (i.json || {}).key) : keys;\nfor (const k of forget) if (k) delete seen[k];\nsd.alertSeen = seen;\nreturn [];"
      }
    }
