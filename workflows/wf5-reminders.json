      "id": "5a0e0017-0015-4c00-8000-000000000015",
      "name": "Orphan Pending",
      "notes": "Expired pending rows that already have a calendar event. Not cancelled: the event may be live and the booking real. The owner is told, once per run, until the rows are fixed by hand.",
      "retryOnFail": true,
      "maxTries": 2,
