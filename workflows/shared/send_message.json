    {
      "id": "5e5d0001-0007-4c00-8000-000000000007",
      "name": "Render",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1320,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "/*TEMPLATES*/ const T = {\"NON_TEXT\":\"I can only read text messages for now. Please type your request.\",\"RATE_LIMIT\":\"You have sent many messages in a short time. I will pause for a few minutes; a team member has been notified.\",\"ESCALATED_HOLD\":\"A team member will contact you shortly. Automatic replies are paused for this conversation.\",\"ERROR\":\"Something went wrong on our side — a team member will get back to you shortly.\",\"PENDING_SUMMARY\":\"{service} ({duration} min) — {when}. Reply YES to confirm.\",\"BOOKED\":\"You're booked: {service} ({duration} min) — {when}. We'll remind you {reminder_hours} hours before. To change or cancel, just message me here.\",\"BOOKED_INTAKE\":\"Before your first visit, please complete our short intake and consent form (about 5 minutes): {intake_form_url}\",\"SLOT_TAKEN\":\"Sorry — that time was just taken by another booking. Nearby options: {alternatives}. Which one works for you?\",\"EXPIRED\":\"That offer has expired (we hold offers for {ttl} minutes). Tell me the service and day again and I'll check availability.\",\"ALREADY_BOOKED\":\"You're already confirmed: {service} — {when}. Anything else I can help with?\",\"REMINDER\":\"Reminder: {service} — {when} at {business_name}. Reply YES to confirm or NO to cancel.\",\"REMINDER_CONFIRMED\":\"Thank you — your {service} on {when} is confirmed. See you soon!\",\"REMINDER_CANCELLED\":\"Your {service} on {when} has been cancelled. Message me any time to book again.\",\"REVISIT\":\"Hi {name}, it has been {days} days since your {service} at {business_name}. Would you like to book your next visit?\",\"ESCALATED_REPLY\":\"I've passed this to our team — a team member will contact you shortly.\"}; /*END*/\nconst inp = $('Trigger').first().json;\nconst s = $('Settings').first().json.fields;\nif (!s) throw new Error('send_message: Settings table is empty or unreadable');\nconst client = ($('Client').first().json.fields || {});\nlet appt = ($('Appointment').first().json.fields || {});\n// The appointment must belong to the client being written to; otherwise treat it as absent (a missing Clients row counts as a mismatch).\nif (appt.client_id && appt.client_id !== client.client_id) appt = {};\nconst services = $('Services').all().map(i => i.json.fields || {});\nconst language = (client.language || 'en').toLowerCase();\nlet text = inp.text || '';\nlet vars = {};\n// A WhatsApp template goes out in English with parameters from vars: the translation would be thrown away, so skip it.\nconst asWaTemplate = String(inp.contact_id || '').startsWith('wa:') && String(inp.outside_window || '').toLowerCase() === 'true';\nif (inp.template_key) {\n  const tpl = T[inp.template_key];\n  if (!tpl) throw new Error('Unknown template_key ' + inp.template_key);\n  const svc = services.find(x => x.service_id === appt.service_id) || {};\n  const when = appt.start_iso ? DateTime.fromISO(appt.start_iso).setZone(s.timezone).toFormat('ccc, LLL d, h:mm a') : '';\n  vars = Object.assign({\n    service: svc.name || '', duration: svc.duration_min || '', when,\n    business_name: s.business_name, reminder_hours: s.reminder_hours_before, ttl: s.pending_ttl_min,\n    intake_form_url: s.intake_form_url, name: client.name || '', days: appt.next_visit_in || '', alternatives: ''\n  }, inp.vars_json ? JSON.parse(inp.vars_json) : {});\n  const REQ = { PENDING_SUMMARY: ['service', 'duration', 'when'], BOOKED: ['service', 'duration', 'when'], ALREADY_BOOKED: ['service', 'when'], REMINDER: ['service', 'when'], REMINDER_CONFIRMED: ['service', 'when'], REMINDER_CANCELLED: ['service', 'when'], SLOT_TAKEN: ['alternatives'], REVISIT: ['name', 'days', 'service'], EXPIRED: ['ttl'], BOOKED_INTAKE: ['intake_form_url'] };\n  for (const k of (REQ[inp.template_key] || [])) {\n    if (String(vars[k] ?? '').trim() === '') throw new Error('send_message: template ' + inp.template_key + ' needs \"' + k + '\" but it is empty (contact_id=' + inp.contact_id + ', appt_id=' + (inp.appt_id || '-') + ')');\n  }\n  text = tpl.replace(/\\{(\\w+)\\}/g, (_, k) => (vars[k] ?? '').toString());\n}\nreturn [{ json: { text, language, vars, needs_translation: !!inp.template_key && language !== 'en' && !asWaTemplate } }];"
      }
    },
