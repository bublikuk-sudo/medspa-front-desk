      "id": "5e5d0001-0011-4c00-8000-000000000011",
      "name": "Merge Text",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1980,
        400
      ],
      "parameters": {
        "assignments": {
