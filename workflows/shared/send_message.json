    {
      "id": "5e5d0001-0012-4c00-8000-000000000012",
      "name": "Format",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        400
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Approved WhatsApp templates (Task 15 Step 6 table). The names are PLACEHOLDERS until Meta approves the templates; params are in Meta's {{1}}, {{2}}... order.\nconst WA_TPL = {\n  REMINDER: { name: 'medspa_reminder', lang: 'en', params: ['service', 'when', 'business_name'] },\n  REVISIT: { name: 'medspa_revisit', lang: 'en', params: ['name', 'days', 'service', 'business_name'] }\n};\nconst inp = $('Trigger').first().json;\nconst client = ($('Client').first().json.fields || {});\nconst raw = String(inp.contact_id || '').trim();\nconst isTg = /^tg:\\d+$/.test(raw);\nconst isWa = /^wa:\\+\\d+$/.test(raw);\nif (!isTg && !isWa) throw new Error('send_message: contact_id must be tg:<digits> or wa:+<digits>, got \"' + raw + '\"');\nconst channel = isTg ? 'tg' : 'wa';\nlet text = ($json.text || '').toString().trim();\nif (!text) throw new Error('send_message: nothing to send (empty text)');\nconst outside = String(inp.outside_window || '').toLowerCase() === 'true';\nlet wa_template = '';\nlet wa_key = '';\nlet wa_params = [];\nif (channel === 'tg') {\n  // Trim the raw text first so the cut can never land inside a tag or an entity; then escape & < > BEFORE inserting tags.\n  text = text.slice(0, 4000).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\\*\\*(.+?)\\*\\*/g, '<b>$1</b>');\n} else {\n  text = text.replace(/\\*\\*(.+?)\\*\\*/g, '$1').slice(0, 1500);\n  if (outside) {\n    const spec = WA_TPL[inp.template_key];\n    if (!spec) throw new Error('send_message: outside_window=true needs template_key REMINDER or REVISIT, got \"' + (inp.template_key || '') + '\"');\n    const vars = $('Render').first().json.vars || {};\n    wa_template = spec.name + '|' + spec.lang;\n    wa_key = inp.template_key;\n    wa_params = spec.params.map(k => String(vars[k] ?? '').trim() || '-');\n  }\n}\nreturn [{ json: { text, channel, chat_id: channel === 'tg' ? raw.slice(3) : '', phone: channel === 'wa' ? (client.phone || raw.slice(3)) : '', outside_window: outside, wa_key, wa_template, wa_params } }];"
      }
    },
