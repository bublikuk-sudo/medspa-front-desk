{
  "name": "notify_owner",
  "nodes": [
    {
      "id": "a0b10006-0001-4c00-8000-000000000001",
      "name": "Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "text", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "a0b10006-0002-4c00-8000-000000000002",
      "name": "Settings",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 300],
      "alwaysOutputData": true,
      "onError": "continueErrorOutput",
      "notes": "Error output goes to Direct Telegram: the alert must not depend on Airtable, the thing it usually reports. Do not remove.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Settings", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "a0b10006-0005-4c00-8000-000000000005",
      "name": "Check Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [330, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// If the Settings read failed, alwaysOutputData also puts an empty item on this branch while the error item goes to Direct Telegram (output 1). Stop quietly here: throwing would abort the run before that branch executes.\nif ($('Settings').all(1).length > 0) return [];\nconst f = $input.first().json.fields;\nif (!f || !String(f.owner_contact || '').trim()) throw new Error('notify_owner: Settings row missing or owner_contact empty');\nreturn $input.all();"
      }
    },
    {
      "id": "a0b10006-0003-4c00-8000-000000000003",
      "name": "Send Owner",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, 300],
      "notes": "Trim-then-escape on purpose: Telegram's 4096 limit counts parsed characters, not the escaped request text, and escaping first could cut inside an entity (&amp;). Do not reorder.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "telegramApi": { "id": "CRED", "name": "MedSpa Telegram" }
      },
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.fields.owner_contact }}",
        "text": "={{ String($('Trigger').first().json.text || '').slice(0, 4000).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "disable_notification": false
        }
      }
    },
    {
      "id": "a0b10006-0004-4c00-8000-000000000004",
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [660, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0b10006-2001-4c00-8000-000000000001",
              "name": "verdict",
              "value": "SENT",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "a0b10006-0006-4c00-8000-000000000006",
      "name": "Direct Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [440, 520],
      "notes": "Airtable-free path: reached only when the Settings read fails. The chat id comes from the container environment (OWNER_TELEGRAM_CHAT_ID), not from Airtable. Same trim-then-escape as Send Owner. No retry: a send that timed out may have been delivered.",
      "credentials": {
        "telegramApi": { "id": "CRED", "name": "MedSpa Telegram" }
      },
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.OWNER_TELEGRAM_CHAT_ID }}",
        "text": "={{ String($('Trigger').first().json.text || '').slice(0, 4000).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') }}",
        "additionalFields": {
          "parse_mode": "HTML",
          "appendAttribution": false,
          "disable_web_page_preview": true,
          "disable_notification": false
        }
      }
    },
    {
      "id": "a0b10006-0007-4c00-8000-000000000007",
      "name": "Result Fallback",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [660, 520],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a0b10006-2002-4c00-8000-000000000002",
              "name": "verdict",
              "value": "SENT_FALLBACK",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Trigger": { "main": [[{ "node": "Settings", "type": "main", "index": 0 }]] },
    "Settings": {
      "main": [
        [{ "node": "Check Settings", "type": "main", "index": 0 }],
        [{ "node": "Direct Telegram", "type": "main", "index": 0 }]
      ]
    },
    "Direct Telegram": { "main": [[{ "node": "Result Fallback", "type": "main", "index": 0 }]] },
    "Check Settings": { "main": [[{ "node": "Send Owner", "type": "main", "index": 0 }]] },
    "Send Owner": { "main": [[{ "node": "Result", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "saveManualExecutions": true }
}
