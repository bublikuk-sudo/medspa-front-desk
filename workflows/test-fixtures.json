    {
      "id": "5d1f0a10-0013-4c00-8000-000000000013",
      "name": "List For Ids",
      "notes": "Lists first so that an id whose event is already gone is skipped: deleting it again is HTTP 410 'Resource has been deleted', and with continueOnFail the node keeps only the generic message, so a 410 cannot be told apart from a real error afterwards. Same window as List Test Events.",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [700, 700],
      "alwaysOutputData": true,
      "executeOnce": true,
      "retryOnFail": true,
