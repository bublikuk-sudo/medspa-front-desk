    {
      "id": "5d1f0a10-0004-4c00-8000-000000000004",
      "name": "Create Busy",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [700, 100],
      "notes": "No retry on purpose: a retry after a timed-out create that actually succeeded would make a duplicate [TEST] busy block. Do not add retryOnFail here.",
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "CRED", "name": "MedSpa Google Calendar" }
      },
      "parameters": {
        "resource": "event",
        "operation": "create",
        "calendar": { "__rl": true, "value": "={{ $('Settings').first().json.fields.calendar_id }}", "mode": "id" },
        "start": "={{ $('Trigger').item.json.start_iso }}",
        "end": "={{ $('Trigger').item.json.end_iso }}",
        "useDefaultReminders": true,
        "additionalFields": {
          "summary": "[TEST] busy",
          "description": "test-fixture"
        }
      }
    },
    {
      "id": "5d1f0a10-0005-4c00-8000-000000000005",
      "name": "Result Created",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [920, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5d1f0a10-2001-4c00-8000-000000000001",
              "name": "verdict",
              "value": "={{ 'BUSY_CREATED ' + $json.id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5d1f0a10-0006-4c00-8000-000000000006",
      "name": "List Test Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [700, 300],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "CRED", "name": "MedSpa Google Calendar" }
      },
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": { "__rl": true, "value": "={{ $('Settings').first().json.fields.calendar_id }}", "mode": "id" },
        "returnAll": true,
        "timeMin": "={{ $now.minus({days: 365}).toISO() }}",
        "timeMax": "={{ $now.plus({years: 10}).toISO() }}",
        "options": {
          "query": "[TEST]"
        }
      }
    },
    {
      "id": "5d1f0a10-0011-4c00-8000-000000000011",
      "name": "Only Test Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Safety net: only events whose title starts with [TEST] are ever deleted, whatever the search query matched.\nconst hits = $input.all().filter(i => i.json && i.json.id && String(i.json.summary || '').startsWith('[TEST]'));\nreturn hits.length ? hits : [{ json: { none: true } }];"
      }
    },
    {
      "id": "5d1f0a10-0012-4c00-8000-000000000012",
      "name": "Any Test Events?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1140, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "5d1f0a10-1004-4c00-8000-000000000004",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "exists", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "5d1f0a10-0007-4c00-8000-000000000007",
      "name": "Delete Each",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1360, 200],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "CRED", "name": "MedSpa Google Calendar" }
      },
      "parameters": {
        "resource": "event",
        "operation": "delete",
        "calendar": { "__rl": true, "value": "={{ $('Settings').first().json.fields.calendar_id }}", "mode": "id" },
        "eventId": "={{ $json.id }}",
        "options": {}
      }
    },
    {
      "id": "5d1f0a10-0008-4c00-8000-000000000008",
      "name": "Result Deleted",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1580, 300],
      "executeOnce": true,
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5d1f0a10-2002-4c00-8000-000000000002",
              "name": "verdict",
              "value": "={{ 'DELETED ' + $('Only Test Events').all().filter(i => i.json.id).length }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "5d1f0a10-0009-4c00-8000-000000000009",
      "name": "List Events",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [700, 500],
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "CRED", "name": "MedSpa Google Calendar" }
      },
      "parameters": {
        "resource": "event",
        "operation": "getAll",
        "calendar": { "__rl": true, "value": "={{ $('Settings').first().json.fields.calendar_id }}", "mode": "id" },
        "returnAll": true,
        "timeMin": "={{ $('Trigger').item.json.start_iso }}",
        "timeMax": "={{ $('Trigger').item.json.end_iso }}",
        "options": {}
      }
    },
    {
      "id": "5d1f0a10-0010-4c00-8000-000000000010",
      "name": "Result Events",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, 500],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const events = $input.all().map(i => i.json).filter(e => e && e.id);\nreturn [{ json: {\n  verdict: 'EVENTS ' + events.length,\n  events: events.map(e => ({ id: e.id, summary: e.summary, description: e.description || '', start: e.start && (e.start.dateTime || e.start.date), end: e.end && (e.end.dateTime || e.end.date) }))\n}}];"
      }
    }
  ],
  "connections": {
    "Trigger": { "main": [[{ "node": "Settings", "type": "main", "index": 0 }]] },
    "Settings": { "main": [[{ "node": "Route", "type": "main", "index": 0 }]] },
    "Route": {
