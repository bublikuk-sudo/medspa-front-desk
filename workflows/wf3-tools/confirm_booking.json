    {
      "id": "9c0f0001-0012-4c00-8000-000000000012",
      "name": "FreeBusy",
      "notes": "Booked Slots output: one item per busy interval, {start, end} in UTC; none gives one empty {} item (alwaysOutputData). A failed calendar call fails the tool: booking blind could double-book.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [1760, 520],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "CRED", "name": "MedSpa Google Calendar" }
      },
      "parameters": {
        "resource": "calendar",
        "operation": "availability",
        "calendar": { "__rl": true, "value": "={{ $('Settings').first().json.fields.calendar_id }}", "mode": "id" },
        "timeMin": "={{ $json.start_iso }}",
        "timeMax": "={{ $json.end_iso }}",
        "options": {
          "outputFormat": "bookedSlots"
        }
      }
    },
    {
      "id": "9c0f0001-0013-4c00-8000-000000000013",
      "name": "Any Busy",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 520],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Taken = some busy interval really overlaps [start, end). The empty {} item of alwaysOutputData is dropped; a busy item that does not parse is not \"free\": throw.\nconst d = $('Decide').first().json;\nconst s = DateTime.fromISO(d.start_iso), e = DateTime.fromISO(d.end_iso);\nconst taken = $input.all().map(i => i.json || {}).filter(b => b.start || b.end).some(b => {\n  const bs = DateTime.fromISO(String(b.start)), be = DateTime.fromISO(String(b.end));\n  if (!bs.isValid || !be.isValid) throw new Error('confirm_booking: unreadable busy interval from Google Calendar: ' + JSON.stringify(b));\n  return bs < e && be > s;\n});\nreturn [{ json: { taken } }];"
      }
    },
