                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "expire"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
                "conditions": [
                  {
                    "id": "9c0f0001-1003-4c00-8000-000000000003",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "check",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "check"
            }
          ]
        },
        "options": {}
      }
