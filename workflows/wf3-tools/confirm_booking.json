{
  "name": "confirm_booking",
  "nodes": [
    {
      "id": "9c0f0001-0001-4c00-8000-000000000001",
      "name": "Trigger",
      "notes": "Not an agent tool: WF-1 calls this after the client's YES. The agent can only create a pending row (propose_booking); the calendar is written only here.",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "contact_id", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "9c0f0001-0002-4c00-8000-000000000002",
      "name": "Settings",
      "notes": "alwaysOutputData: an empty Settings table reaches Decide, which fails the tool (-> WF-6) instead of ending the run silently.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Settings", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "9c0f0001-0003-4c00-8000-000000000003",
      "name": "Client Formula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Validate first: an empty or malformed contact_id must match NO client row (a comparison with '' would match every row whose column is blank).\nconst raw = String($('Trigger').first().json.contact_id || '').trim();\nconst ok = /^(tg:\\d{1,20}|wa:\\+\\d{1,20})$/.test(raw);\nconst formula = ok\n  ? (raw.startsWith('tg:') ? \"{telegram_chat_id}='\" + raw.slice(3) + \"'\" : \"{phone}='\" + raw.slice(3) + \"'\")\n  : \"{client_id}='__no_such_client__'\";\nreturn [{ json: { formula } }];"
      }
    },
    {
      "id": "9c0f0001-0004-4c00-8000-000000000004",
      "name": "Client",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [660, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Clients", "mode": "id" },
        "filterByFormula": "={{ $json.formula }}",
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "9c0f0001-0005-4c00-8000-000000000005",
      "name": "Appointments",
      "notes": "All statuses, not only the live ones: first_visit needs the done visits too.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [880, 300],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "filterByFormula": "={{ \"{client_id}='\" + (/^[A-Za-z0-9_-]{1,64}$/.test(String($json.fields?.client_id || '')) ? $json.fields.client_id : '__no_such_client__') + \"'\" }}",
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "9c0f0001-0006-4c00-8000-000000000006",
