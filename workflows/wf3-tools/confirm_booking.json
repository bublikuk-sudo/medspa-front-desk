    {
      "id": "9c0f0001-0007-4c00-8000-000000000007",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Settings are checked before anything is written: the event goes into Settings.calendar_id.\nconst s = ($('Settings').first().json || {}).fields;\nif (!s) throw new Error('confirm_booking: the Settings table has no row');\nif (typeof s.calendar_id !== 'string' || !s.calendar_id.trim()) throw new Error('confirm_booking: Settings.calendar_id is missing');\nif (typeof s.timezone !== 'string' || !s.timezone.trim() || !DateTime.now().setZone(s.timezone).isValid) throw new Error('confirm_booking: Settings.timezone is missing or not a valid IANA zone, got ' + JSON.stringify(s.timezone));\nconst c = $('Client').first().json || {};   // the whole record: c.id is the Clients record id\nconst cid = (c.fields || {}).client_id;\nif (!c.id || !cid) return [{ json: { action: 'reject', verdict: 'NO_PENDING', appt_id: '' } }];\n// rec_id is the Appointments record id (for the updates), the rest are the columns\nconst appts = $('Appointments').all().map(i => ({ ...((i.json || {}).fields || {}), rec_id: (i.json || {}).id })).filter(a => a.appt_id && a.client_id === cid);\nconst services = $('Services').all().map(i => (i.json || {}).fields || {});\nconst now = DateTime.utc();\nconst ms = (iso) => DateTime.fromISO(String(iso || '')).toMillis();\nconst pending = appts.filter(a => a.status === 'pending').sort((a, b) => String(b.pending_expires_at || '').localeCompare(String(a.pending_expires_at || '')))[0];\nif (!pending) {\n  // No proposal waiting: a repeated YES for a visit that is already booked is ALREADY_BOOKED with that visit's id.\n  const future = appts.filter(a => ['booked', 'reminded', 'confirmed'].includes(a.status) && ms(a.start_iso) > now.toMillis()).sort((a, b) => ms(a.start_iso) - ms(b.start_iso))[0];\n  return [{ json: { action: 'reject', verdict: future ? 'ALREADY_BOOKED ' + future.appt_id : 'NO_PENDING', appt_id: future ? future.appt_id : '' } }];\n}\nconst exp = DateTime.fromISO(String(pending.pending_expires_at || ''));\nif (!exp.isValid || exp < now) return [{ json: { action: 'expire', rec_id: pending.rec_id, appt_id: pending.appt_id } }];\nconst start = DateTime.fromISO(String(pending.start_iso || '')), end = DateTime.fromISO(String(pending.end_iso || ''));\nif (!start.isValid || !end.isValid || end <= start) throw new Error('confirm_booking: pending appointment ' + pending.appt_id + ' has an unreadable start_iso/end_iso');\nconst svc = services.find(x => x.service_id === pending.service_id) || {};\nconst hadVisits = appts.some(a => ['booked', 'reminded', 'confirmed', 'done'].includes(a.status));\nreturn [{ json: { action: 'check', rec_id: pending.rec_id, appt_id: pending.appt_id, start_iso: pending.start_iso, end_iso: pending.end_iso,\n  service_id: pending.service_id, service_name: svc.name || pending.service_id, replaces_appt_id: pending.replaces_appt_id || '', first_visit: !hadVisits } }];"
      }
    },
    {
