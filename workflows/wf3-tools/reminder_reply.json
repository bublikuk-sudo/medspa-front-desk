          "value": {
            "id": "={{ $('Client').first().json.id }}",
            "status": "={{ $('Client').first().json.fields.status === 'escalated' ? 'escalated' : 'flagged' }}"
          },
          "matchingColumns": ["id"],
          "schema": [
            { "id": "id", "displayName": "id", "required": false, "defaultMatch": true, "display": true, "type": "string", "readOnly": true, "removed": false },
            {
              "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "options",
              "options": [
                { "name": "new", "value": "new" }, { "name": "active", "value": "active" },
                { "name": "flagged", "value": "flagged" }, { "name": "escalated", "value": "escalated" }
              ],
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "9e0b0001-0015-4c00-8000-000000000015",
      "name": "Notify",
      "notes": "Continue on error: the visit is already cancelled, so the client must still get CANCELLED. notify_owner retries its own nodes and has an Airtable-free fallback.",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [2640, 560],
      "onError": "continueRegularOutput",
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "WFID:notify_owner", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "text": "={{ (() => { const d = $('Decide').first().json; const fc = ($('Flag Client').first() || {}).json || {}; const flag = !fc.id ? ' — the client could NOT be flagged automatically, flag them by hand' : ((fc.fields || {}).status === 'escalated' ? ' — client is escalated, left escalated (not flagged)' : ' — client flagged'); const gone = $('Gone Check').isExecuted && ($('Gone Check').first().json || {}).event === 'already_gone' ? ' — the calendar event was already gone, check the calendar by hand' : ''; return 'ℹ️ Cancelled via reminder: ' + (String($('Client').first().json.fields.name || '').replace(/\\s+/g, ' ').trim().slice(0, 80) || '(no name)') + ' (' + $('Trigger').first().json.contact_id + ') — ' + d.service_id + ' — ' + d.when + ' — ' + d.appt_id + flag + gone; })() }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {}
      }
    },
    {
      "id": "9e0b0001-0016-4c00-8000-000000000016",
      "name": "Result Cancelled",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [2860, 560],
      "parameters": {
        "assignments": {
