            "status": "cancelled",
            "calendar_event_id": ""
          },
          "matchingColumns": ["id"],
          "schema": [
            { "id": "id", "displayName": "id", "required": false, "defaultMatch": true, "display": true, "type": "string", "readOnly": true, "removed": false },
            {
              "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "options",
              "options": [
                { "name": "pending", "value": "pending" }, { "name": "booked", "value": "booked" }, { "name": "reminded", "value": "reminded" },
                { "name": "confirmed", "value": "confirmed" }, { "name": "cancelled", "value": "cancelled" }, { "name": "late_cancel", "value": "late_cancel" },
                { "name": "no_show", "value": "no_show" }, { "name": "done", "value": "done" }
              ],
              "removed": false
            },
            { "id": "calendar_event_id", "displayName": "calendar_event_id", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string", "removed": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "9e0b0001-0017-4c00-8000-000000000017",
      "name": "Flag Client",
      "notes": "Spec: a NO to the reminder flags the client; an escalated client stays escalated (the owner already handles them). Continue on error: the visit IS cancelled, so the client must get CANCELLED; Notify tells the owner when the flag could not be written.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [2420, 560],
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "update",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Clients", "mode": "id" },
        "columns": {
