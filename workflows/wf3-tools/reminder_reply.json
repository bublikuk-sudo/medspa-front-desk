{
  "name": "reminder_reply",
  "nodes": [
    {
      "id": "9e0b0001-0001-4c00-8000-000000000001",
      "name": "Trigger",
      "notes": "Not an agent tool: WF-1 calls this when a client with a reminded visit answers yes/no. answer must be yes or no (WF-1 only passes those); anything else fails the tool (-> WF-6) rather than guessing.",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "contact_id", "type": "string" },
            { "name": "answer", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "9e0b0001-0002-4c00-8000-000000000002",
      "name": "Settings",
      "notes": "alwaysOutputData: an empty Settings table reaches Decide, which fails the tool (-> WF-6) instead of ending the run silently.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Settings", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "9e0b0001-0003-4c00-8000-000000000003",
      "name": "Client Formula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Validate first: an empty or malformed contact_id must match NO client row (a comparison with '' would match every row whose column is blank).\nconst raw = String($('Trigger').first().json.contact_id || '').trim();\nconst ok = /^(tg:\\d{1,20}|wa:\\+\\d{1,20})$/.test(raw);\nconst formula = ok\n  ? (raw.startsWith('tg:') ? \"{telegram_chat_id}='\" + raw.slice(3) + \"'\" : \"{phone}='\" + raw.slice(3) + \"'\")\n  : \"{client_id}='__no_such_client__'\";\nreturn [{ json: { formula } }];"
      }
    },
    {
      "id": "9e0b0001-0004-4c00-8000-000000000004",
      "name": "Client",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [660, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Clients", "mode": "id" },
        "filterByFormula": "={{ $json.formula }}",
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "9e0b0001-0005-4c00-8000-000000000005",
      "name": "Reminded",
      "notes": "client_id goes into the formula only if it is a plain id.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [880, 300],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "filterByFormula": "={{ \"AND({client_id}='\" + (/^[A-Za-z0-9_-]{1,64}$/.test(String($json.fields?.client_id || '')) ? $json.fields.client_id : '__no_such_client__') + \"',{status}='reminded')\" }}",
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "9e0b0001-0006-4c00-8000-000000000006",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The answer applies to the client's NEXT reminded visit (earliest start still ahead). A NO is status cancelled (not\n// late_cancel), the slot is freed and the client is flagged (spec: reminders, 'no' -> cancelled, slot freed, client flagged).\nconst s = ($('Settings').first().json || {}).fields;\nif (!s) throw new Error('reminder_reply: the Settings table has no row');\nif (typeof s.calendar_id !== 'string' || !s.calendar_id.trim()) throw new Error('reminder_reply: Settings.calendar_id is missing');\nif (typeof s.timezone !== 'string' || !s.timezone.trim() || !DateTime.now().setZone(s.timezone).isValid) throw new Error('reminder_reply: Settings.timezone is missing or not a valid IANA zone, got ' + JSON.stringify(s.timezone));\nconst answer = String($('Trigger').first().json.answer || '').trim().toLowerCase();\nif (!['yes', 'no'].includes(answer)) throw new Error('reminder_reply: answer must be yes or no, got ' + JSON.stringify(String($('Trigger').first().json.answer || '').slice(0, 40)));\nconst c = $('Client').first().json || {};\nconst cid = (c.fields || {}).client_id;\nif (!c.id || !cid) return [{ json: { action: 'none' } }];\nconst now = DateTime.utc();\n// rec_id is the Appointments record id (for the updates), the rest are the columns\nconst appts = $('Reminded').all().map(i => ({ ...((i.json || {}).fields || {}), rec_id: (i.json || {}).id }))\n  .filter(a => a.appt_id && a.client_id === cid && a.status === 'reminded')\n  .map(a => ({ ...a, start: DateTime.fromISO(String(a.start_iso || '')) }))\n  .filter(a => a.start.isValid && a.start > now)\n  .sort((x, y) => x.start.toMillis() - y.start.toMillis());\nconst a = appts[0];\nif (!a) return [{ json: { action: 'none' } }];\n// The event id goes into the Delete Event URL path unencoded: only a plain Google event id is accepted.\nconst ev = String(a.calendar_event_id || '').trim();\nif (ev && !/^[A-Za-z0-9_-]{1,1024}$/.test(ev)) throw new Error('reminder_reply: unexpected calendar_event_id ' + JSON.stringify(ev.slice(0, 80)) + ' on appointment ' + a.appt_id);\nreturn [{ json: { action: answer === 'yes' ? 'confirm' : 'cancel', rec_id: a.rec_id, appt_id: a.appt_id, calendar_event_id: ev,\n  service_id: a.service_id || '', when: a.start.setZone(s.timezone).toFormat('ccc, LLL d, h:mm a') } }];"
      }
    },
    {
      "id": "9e0b0001-0007-4c00-8000-000000000007",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [1320, 300],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
                "conditions": [
