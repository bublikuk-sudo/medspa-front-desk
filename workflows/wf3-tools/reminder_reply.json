    {
      "id": "9e0b0001-0012-4c00-8000-000000000012",
      "name": "Delete Event",
      "notes": "Same as cancel_booking's Delete Event: HTTP Request so that Gone Check sees the exact HTTP status (the Google Calendar node keeps only a generic message on failure). Network errors and timeouts still throw (retried once, then the tool fails -> WF-6).",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 480],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "CRED", "name": "MedSpa Google Calendar" }
      },
      "parameters": {
        "method": "DELETE",
        "url": "={{ 'https://www.googleapis.com/calendar/v3/calendars/' + encodeURIComponent($('Settings').first().json.fields.calendar_id.trim()) + '/events/' + $('Decide').first().json.calendar_event_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "9e0b0001-0013-4c00-8000-000000000013",
      "name": "Gone Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 480],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 2xx = deleted now; 404/410 = already gone: the cancellation goes on. Anything else fails the tool (-> WF-6) BEFORE the row is\n// marked, so a cancelled row never leaves a live event blocking the slot.\nconst d = $('Decide').first().json;\nconst r = $input.first().json || {};\nconst code = Number(r.statusCode);\nif (code >= 200 && code < 300) return [{ json: { event: 'deleted' } }];\nif (code === 404 || code === 410) return [{ json: { event: 'already_gone' } }];\nlet body = '';\ntry { body = typeof r.body === 'string' ? r.body : JSON.stringify(r.body); } catch (e) { body = ''; }\nthrow new Error('reminder_reply: deleting calendar event ' + d.calendar_event_id + ' of ' + d.appt_id + ' failed with HTTP ' + (Number.isFinite(code) ? code : JSON.stringify(r.statusCode)) + ': ' + String(body || '').slice(0, 300) + ' - the appointment was NOT marked cancelled');"
      }
    },
    {
      "id": "9e0b0001-0014-4c00-8000-000000000014",
      "name": "Mark Cancelled",
      "notes": "calendar_event_id is cleared: the event is gone (deleted here or already).",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [2200, 560],
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "update",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "columns": {
