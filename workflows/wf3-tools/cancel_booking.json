{
  "name": "cancel_booking",
  "nodes": [
    {
      "id": "9d0a0001-0001-4c00-8000-000000000001",
      "name": "Trigger",
      "notes": "Agent tool: contact_id and appt_id (from find_client's upcoming). reason is not given by the agent (= cancel, the late-cancel policy applies); confirm_booking's Cancel Replaced passes reason=reschedule, which always cancels without the late-cancel flag.",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "contact_id", "type": "string" },
            { "name": "appt_id", "type": "string" },
            { "name": "reason", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "9d0a0001-0002-4c00-8000-000000000002",
      "name": "Settings",
      "notes": "alwaysOutputData: an empty Settings table reaches Decide, which fails the tool (-> WF-6) instead of ending the run silently.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Settings", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0003-4c00-8000-000000000003",
      "name": "Client Formula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Validate first: an empty or malformed contact_id must match NO client row (a comparison with '' would match every row whose column is blank).\nconst raw = String($('Trigger').first().json.contact_id || '').trim();\nconst ok = /^(tg:\\d{1,20}|wa:\\+\\d{1,20})$/.test(raw);\nconst formula = ok\n  ? (raw.startsWith('tg:') ? \"{telegram_chat_id}='\" + raw.slice(3) + \"'\" : \"{phone}='\" + raw.slice(3) + \"'\")\n  : \"{client_id}='__no_such_client__'\";\nreturn [{ json: { formula } }];"
      }
    },
    {
      "id": "9d0a0001-0004-4c00-8000-000000000004",
      "name": "Client",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [660, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Clients", "mode": "id" },
        "filterByFormula": "={{ $json.formula }}",
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0005-4c00-8000-000000000005",
      "name": "Appointment",
      "notes": "appt_id goes into the formula only if it is a plain appt_id (^A-[0-9A-Z-]{1,40}$); anything else searches for a row that cannot exist, and Decide answers NOT_FOUND.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [880, 300],
      "alwaysOutputData": true,
      "executeOnce": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "filterByFormula": "={{ \"{appt_id}='\" + (/^A-[0-9A-Z-]{1,40}$/.test(String($('Trigger').first().json.appt_id || '').trim()) ? String($('Trigger').first().json.appt_id).trim() : '__no_such_appt__') + \"'\" }}",
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0006-4c00-8000-000000000006",
      "name": "Decide",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1100, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The decision is made here, not by the model: only a live visit of THIS client can be cancelled, and the late-cancel policy\n// (Settings.cancellation_hours) is applied here. A reschedule (reason=reschedule, from confirm_booking) is never a late cancel:\n// the client keeps the clinic booked.\nconst s = ($('Settings').first().json || {}).fields;\nif (!s) throw new Error('cancel_booking: the Settings table has no row');\nif (typeof s.calendar_id !== 'string' || !s.calendar_id.trim()) throw new Error('cancel_booking: Settings.calendar_id is missing');\nif (typeof s.timezone !== 'string' || !s.timezone.trim() || !DateTime.now().setZone(s.timezone).isValid) throw new Error('cancel_booking: Settings.timezone is missing or not a valid IANA zone, got ' + JSON.stringify(s.timezone));\nconst hrs = (s.cancellation_hours === null || s.cancellation_hours === undefined || String(s.cancellation_hours).trim() === '') ? NaN : Number(s.cancellation_hours);\nif (!Number.isFinite(hrs) || hrs < 0) throw new Error('cancel_booking: Settings.cancellation_hours must be a number >= 0, got ' + JSON.stringify(s.cancellation_hours));\nconst inp = $('Trigger').first().json;\nconst reason = String(inp.reason || '').trim().toLowerCase() === 'reschedule' ? 'reschedule' : 'cancel';\nconst want = String(inp.appt_id || '').trim();\nconst valid = /^A-[0-9A-Z-]{1,40}$/.test(want);\nconst reject = (verdict) => [{ json: { action: 'reject', verdict, appt_id: valid ? want : '' } }];\nif (!valid) return reject('NOT_FOUND');\nconst ar = $('Appointment').first().json || {};   // the whole record: ar.id is the Appointments record id, the columns are in ar.fields\nconst a = ar.fields || {};\nif (!ar.id || a.appt_id !== want) return reject('NOT_FOUND');\nconst c = $('Client').first().json || {};\nconst cid = (c.fields || {}).client_id;\nif (!c.id || !cid || a.client_id !== cid) return reject('NOT_YOURS');\nif (!['pending', 'booked', 'reminded', 'confirmed'].includes(a.status)) return reject('NOT_FOUND');\nconst start = DateTime.fromISO(String(a.start_iso || ''));\nif (!start.isValid) throw new Error('cancel_booking: appointment ' + want + ' has an unreadable start_iso ' + JSON.stringify(a.start_iso));\n// The event id goes into the Delete Event URL path unencoded: only a plain Google event id is accepted.\nconst ev = String(a.calendar_event_id || '').trim();\nif (ev && !/^[A-Za-z0-9_-]{1,1024}$/.test(ev)) throw new Error('cancel_booking: unexpected calendar_event_id ' + JSON.stringify(ev.slice(0, 80)) + ' on appointment ' + want);\nconst hoursLeft = start.diff(DateTime.utc(), 'hours').hours;\nconst late = reason === 'cancel' && a.status !== 'pending' && hoursLeft < hrs;\nreturn [{ json: { action: 'cancel', rec_id: ar.id, appt_id: want, calendar_event_id: ev, new_status: late ? 'late_cancel' : 'cancelled', reason,\n  service_id: a.service_id || '', start_iso: a.start_iso, when: start.setZone(s.timezone).toFormat('ccc, LLL d, h:mm a') } }];"
      }
    },
    {
      "id": "9d0a0001-0007-4c00-8000-000000000007",
      "name": "Route",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [1320, 300],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
                "conditions": [
                  {
                    "id": "9d0a0001-1001-4c00-8000-000000000001",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "reject",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "reject"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
                "conditions": [
                  {
                    "id": "9d0a0001-1002-4c00-8000-000000000002",
                    "leftValue": "={{ $json.action }}",
                    "rightValue": "cancel",
                    "operator": { "type": "string", "operation": "equals" }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "cancel"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0008-4c00-8000-000000000008",
      "name": "Result Reject",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1540, 100],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9d0a0001-2001-4c00-8000-000000000001",
              "name": "verdict",
              "value": "={{ $json.verdict }}",
              "type": "string"
            },
            {
              "id": "9d0a0001-2002-4c00-8000-000000000002",
              "name": "appt_id",
              "value": "={{ $json.appt_id || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0009-4c00-8000-000000000009",
      "name": "Has Event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1540, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "9d0a0001-1003-4c00-8000-000000000003",
              "leftValue": "={{ !!$json.calendar_event_id }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0010-4c00-8000-000000000010",
      "name": "Delete Event",
      "notes": "HTTP Request instead of the Google Calendar node: with continue-on-fail that node keeps only a generic error message, so 'already deleted' (410) could not be told from any other failure. neverError + fullResponse give the exact HTTP status to Gone Check. Network errors and timeouts still throw (retried once, then the tool fails -> WF-6).",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1760, 300],
      "credentials": {
        "googleCalendarOAuth2Api": { "id": "CRED", "name": "MedSpa Google Calendar" }
      },
      "parameters": {
        "method": "DELETE",
        "url": "={{ 'https://www.googleapis.com/calendar/v3/calendars/' + encodeURIComponent($('Settings').first().json.fields.calendar_id.trim()) + '/events/' + $('Decide').first().json.calendar_event_id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleCalendarOAuth2Api",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "9d0a0001-0011-4c00-8000-000000000011",
      "name": "Gone Check",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1980, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 2xx = deleted now; 404/410 = already gone (the owner deleted it by hand, or an earlier run did): the cancellation goes on.\n// Anything else fails the tool (-> WF-6) BEFORE the row is marked, so a cancelled row never leaves a live event blocking the slot.\nconst d = $('Decide').first().json;\nconst r = $input.first().json || {};\nconst code = Number(r.statusCode);\nif (code >= 200 && code < 300) return [{ json: { event: 'deleted' } }];\nif (code === 404 || code === 410) return [{ json: { event: 'already_gone' } }];\nlet body = '';\ntry { body = typeof r.body === 'string' ? r.body : JSON.stringify(r.body); } catch (e) { body = ''; }\nthrow new Error('cancel_booking: deleting calendar event ' + d.calendar_event_id + ' of ' + d.appt_id + ' failed with HTTP ' + (Number.isFinite(code) ? code : JSON.stringify(r.statusCode)) + ': ' + String(body || '').slice(0, 300) + ' - the appointment was NOT marked cancelled');"
      }
    },
    {
      "id": "9d0a0001-0012-4c00-8000-000000000012",
      "name": "Mark",
      "notes": "calendar_event_id is cleared: the event is gone (deleted here or already), and tests/cleanup.sh deletes by the ids still stored on rows.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [2200, 400],
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "update",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Decide').first().json.rec_id }}",
            "status": "={{ $('Decide').first().json.new_status }}",
            "calendar_event_id": ""
          },
          "matchingColumns": ["id"],
          "schema": [
            { "id": "id", "displayName": "id", "required": false, "defaultMatch": true, "display": true, "type": "string", "readOnly": true, "removed": false },
            {
              "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "options",
              "options": [
                { "name": "pending", "value": "pending" }, { "name": "booked", "value": "booked" }, { "name": "reminded", "value": "reminded" },
                { "name": "confirmed", "value": "confirmed" }, { "name": "cancelled", "value": "cancelled" }, { "name": "late_cancel", "value": "late_cancel" },
                { "name": "no_show", "value": "no_show" }, { "name": "done", "value": "done" }
              ],
              "removed": false
            },
            { "id": "calendar_event_id", "displayName": "calendar_event_id", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "string", "removed": false }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0013-4c00-8000-000000000013",
      "name": "Late?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2420, 400],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "9d0a0001-1004-4c00-8000-000000000004",
              "leftValue": "={{ $('Decide').first().json.new_status === 'late_cancel' }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0014-4c00-8000-000000000014",
      "name": "Flag Client",
      "notes": "Late cancel -> flagged; an escalated client stays escalated (the owner already handles them; a flag must not clear that). Continue on error: the visit IS cancelled, so the client must get LATE_CANCEL; Notify tells the owner when the flag could not be written.",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [2640, 300],
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "update",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Clients", "mode": "id" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "id": "={{ $('Client').first().json.id }}",
            "status": "={{ $('Client').first().json.fields.status === 'escalated' ? 'escalated' : 'flagged' }}"
          },
          "matchingColumns": ["id"],
          "schema": [
            { "id": "id", "displayName": "id", "required": false, "defaultMatch": true, "display": true, "type": "string", "readOnly": true, "removed": false },
            {
              "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "canBeUsedToMatch": true, "display": true, "type": "options",
              "options": [
                { "name": "new", "value": "new" }, { "name": "active", "value": "active" },
                { "name": "flagged", "value": "flagged" }, { "name": "escalated", "value": "escalated" }
              ],
              "removed": false
            }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": false
        },
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0015-4c00-8000-000000000015",
      "name": "Notify",
      "notes": "Continue on error: the visit is already cancelled (event gone, row marked), so the client must still get the verdict. notify_owner retries its own nodes and has an Airtable-free fallback.",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [2860, 400],
      "onError": "continueRegularOutput",
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "WFID:notify_owner", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "text": "={{ (() => { const d = $('Decide').first().json; const base = (String($('Client').first().json.fields.name || '').replace(/\\s+/g, ' ').trim().slice(0, 80) || '(no name)') + ' (' + $('Trigger').first().json.contact_id + ') — ' + d.service_id + ' — ' + d.when + ' — ' + d.appt_id; if (d.reason === 'reschedule') return '🔁 Rescheduled, old visit cancelled: ' + base; if (d.new_status !== 'late_cancel') return 'ℹ️ Cancelled: ' + base; const flagged = !!(($('Flag Client').first() || {}).json || {}).id; return '⚠️ LATE cancellation: ' + base + (flagged ? ' — client flagged' : ' — the client could NOT be flagged automatically, flag them by hand'); })() }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {}
      }
    },
    {
      "id": "9d0a0001-0016-4c00-8000-000000000016",
      "name": "Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [3080, 400],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "9d0a0001-2003-4c00-8000-000000000003",
              "name": "verdict",
              "value": "={{ $('Decide').first().json.new_status === 'late_cancel' ? 'LATE_CANCEL' : 'CANCELLED' }}",
              "type": "string"
            },
            {
              "id": "9d0a0001-2004-4c00-8000-000000000004",
              "name": "appt_id",
              "value": "={{ $('Decide').first().json.appt_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    }
  ],
  "connections": {
    "Trigger": { "main": [[{ "node": "Settings", "type": "main", "index": 0 }]] },
    "Settings": { "main": [[{ "node": "Client Formula", "type": "main", "index": 0 }]] },
    "Client Formula": { "main": [[{ "node": "Client", "type": "main", "index": 0 }]] },
