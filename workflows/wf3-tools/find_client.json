{
  "name": "find_client",
  "nodes": [
    {
      "id": "f1c10001-0001-4c00-8000-000000000001",
      "name": "Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "contact_id", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "f1c10001-0002-4c00-8000-000000000002",
      "name": "Settings",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 300],
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Settings", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "f1c10001-0003-4c00-8000-000000000003",
      "name": "Client Formula",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [440, 300],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1c10001-2001-4c00-8000-000000000001",
              "name": "formula",
              "value": "={{ $('Trigger').first().json.contact_id.startsWith('tg:') ? \"{telegram_chat_id}='\" + $('Trigger').first().json.contact_id.slice(3) + \"'\" : \"{phone}='\" + $('Trigger').first().json.contact_id.slice(3) + \"'\" }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f1c10001-0004-4c00-8000-000000000004",
      "name": "Client",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [660, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Clients", "mode": "id" },
        "filterByFormula": "={{ $json.formula }}",
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "f1c10001-0005-4c00-8000-000000000005",
      "name": "Known?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [880, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "f1c10001-1001-4c00-8000-000000000001",
              "leftValue": "={{ !!$json.fields?.client_id && !!$json.fields?.name }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f1c10001-0006-4c00-8000-000000000006",
      "name": "Result New",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1100, 460],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1c10001-2002-4c00-8000-000000000002",
              "name": "verdict",
              "value": "NEW",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f1c10001-0007-4c00-8000-000000000007",
      "name": "Appointments",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [1100, 160],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "filterByFormula": "={{ \"{client_id}='\" + $('Client').first().json.fields.client_id +\"'\" }}",
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "f1c10001-0008-4c00-8000-000000000008",
      "name": "Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 160],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The Airtable node (2.2) nests the columns: every row is { id, createdTime, fields: {...} }.\nconst c = $('Client').first().json.fields;\nconst tz = $('Settings').first().json.fields.timezone;\nconst now = DateTime.now().setZone(tz);\nconst appts = $input.all().map(i => i.json.fields || {}).filter(a => a.appt_id);\nconst byStart = (a, b) => a.start_iso.localeCompare(b.start_iso);\nconst done = appts.filter(a => a.status === 'done').sort(byStart).reverse()[0];\nconst upcoming = appts.filter(a => ['booked', 'reminded', 'confirmed'].includes(a.status) && DateTime.fromISO(a.start_iso) > now).sort(byStart);\nlet v = `KNOWN name=\"${c.name}\" language=${c.language || 'en'} status=${c.status || 'active'}`;\nif (done) v += ` last_visit=${done.start_iso.slice(0, 10)} last_service=${done.service_id} next_visit_in=${done.next_visit_in ?? ''}`;\nv += ` upcoming=[${upcoming.map(a => `${a.appt_id} ${a.service_id} ${a.start_iso}`).join('; ')}]`;\nif (c.notes) v += ` owner_notes=\"${String(c.notes).replace(/\"/g, \"'\").replace(/\\s+/g, \" \").slice(0, 200)}\"`;\nreturn [{ json: { verdict: v, name: c.name, language: c.language || 'en', last_service: done ? done.service_id : '', upcoming } }];"
      }
    }
  ],
  "connections": {
    "Trigger": { "main": [[{ "node": "Settings", "type": "main", "index": 0 }]] },
    "Settings": { "main": [[{ "node": "Client Formula", "type": "main", "index": 0 }]] },
    "Client Formula": { "main": [[{ "node": "Client", "type": "main", "index": 0 }]] },
    "Client": { "main": [[{ "node": "Known?", "type": "main", "index": 0 }]] },
    "Known?": {
      "main": [
        [{ "node": "Appointments", "type": "main", "index": 0 }],
        [{ "node": "Result New", "type": "main", "index": 0 }]
      ]
    },
    "Appointments": { "main": [[{ "node": "Card", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
