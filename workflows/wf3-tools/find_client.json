{
  "name": "find_client",
  "nodes": [
    {
      "id": "f1c10001-0001-4c00-8000-000000000001",
      "name": "Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            { "name": "contact_id", "type": "string" }
          ]
        }
      }
    },
    {
      "id": "f1c10001-0002-4c00-8000-000000000002",
      "name": "Settings",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [220, 300],
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Settings", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "f1c10001-0003-4c00-8000-000000000003",
      "name": "Client Formula",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Validate first: an empty or malformed contact_id must match NO client row (a comparison with '' would match every row whose column is blank).\nconst raw = String($('Trigger').first().json.contact_id || '').trim();\nconst ok = /^(tg:\\d+|wa:\\+\\d+)$/.test(raw);\nconst formula = ok\n  ? (raw.startsWith('tg:') ? \"{telegram_chat_id}='\" + raw.slice(3) + \"'\" : \"{phone}='\" + raw.slice(3) + \"'\")\n  : \"{client_id}='__no_such_client__'\";\nreturn [{ json: { formula } }];"
      }
    },
    {
      "id": "f1c10001-0004-4c00-8000-000000000004",
      "name": "Client",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [660, 300],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Clients", "mode": "id" },
        "filterByFormula": "={{ $json.formula }}",
        "limit": 1,
        "options": {}
      }
    },
    {
      "id": "f1c10001-0005-4c00-8000-000000000005",
      "name": "Known?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [880, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "f1c10001-1001-4c00-8000-000000000001",
              "leftValue": "={{ !!$json.fields?.client_id && !!String($json.fields?.name ?? '').trim() }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "f1c10001-0006-4c00-8000-000000000006",
      "name": "Result New",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [1100, 460],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f1c10001-2002-4c00-8000-000000000002",
              "name": "verdict",
              "value": "NEW",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f1c10001-0007-4c00-8000-000000000007",
      "name": "Appointments",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [1100, 160],
      "alwaysOutputData": true,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Appointments", "mode": "id" },
        "filterByFormula": "={{ \"{client_id}='\" + $('Client').first().json.fields.client_id +\"'\" }}",
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "f1c10001-0008-4c00-8000-000000000008",
      "name": "Card",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 160],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// The Airtable node (2.2) nests the columns: every row is { id, createdTime, fields: {...} }.\n// Everything the client controls (name, notes, language) is cleaned before it goes into the verdict, so it cannot forge a token such as owner_notes=.\nconst c = $('Client').first().json.fields;\nconst tz = $('Settings').first().json.fields.timezone;\nconst now = DateTime.now().setZone(tz).toMillis();\nconst clean = (s, max) => String(s ?? '').replace(/\"/g, \"'\").replace(/\\s+/g, ' ').trim().slice(0, max);\nconst tok = s => String(s ?? '').replace(/[^\\w.:+-]/g, '');\nconst ms = a => DateTime.fromISO(a.start_iso).toMillis();\nconst byStart = (a, b) => ms(a) - ms(b);\nconst appts = $input.all().map(i => i.json.fields || {}).filter(a => a.appt_id && DateTime.fromISO(a.start_iso).isValid);\nconst done = appts.filter(a => a.status === 'done').sort(byStart).reverse()[0];\nconst upcoming = appts.filter(a => ['booked', 'reminded', 'confirmed'].includes(a.status) && ms(a) > now).sort(byStart);\nlet v = `KNOWN name=\"${clean(c.name, 60)}\" language=${tok(c.language).slice(0, 10) || 'en'} status=${tok(c.status) || 'active'}`;\nif (done) {\n  v += ` last_visit=${DateTime.fromISO(done.start_iso, { zone: tz }).toISODate()} last_service=${tok(done.service_id)}`;\n  const nv = done.next_visit_in;\n  if (nv != null && nv !== '' && Number.isFinite(Number(nv))) v += ` next_visit_in=${Number(nv)}`;\n}\nv += ` upcoming=[${upcoming.map(a => `${tok(a.appt_id)} ${tok(a.service_id)} ${tok(a.start_iso)}`).join('; ')}]`;\nconst notes = clean(c.notes, 200);\nif (notes) v += ` owner_notes=\"${notes}\"`;\nreturn [{ json: { verdict: v } }];"
      }
    }
  ],
  "connections": {
    "Trigger": { "main": [[{ "node": "Settings", "type": "main", "index": 0 }]] },
    "Settings": { "main": [[{ "node": "Client Formula", "type": "main", "index": 0 }]] },
    "Client Formula": { "main": [[{ "node": "Client", "type": "main", "index": 0 }]] },
    "Client": { "main": [[{ "node": "Known?", "type": "main", "index": 0 }]] },
    "Known?": {
      "main": [
        [{ "node": "Appointments", "type": "main", "index": 0 }],
        [{ "node": "Result New", "type": "main", "index": 0 }]
      ]
    },
    "Appointments": { "main": [[{ "node": "Card", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
