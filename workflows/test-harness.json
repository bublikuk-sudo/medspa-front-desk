{
  "name": "test-harness",
  "nodes": [
    {
      "id": "7a3e0b20-0001-4c00-8000-000000000001",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 300],
      "webhookId": "7a3e0b20-aaaa-4c00-8000-00000000f001",
      "credentials": {
        "httpHeaderAuth": { "id": "CRED", "name": "MedSpa Test Key" }
      },
      "parameters": {
        "httpMethod": "POST",
        "path": "test-tool",
        "authentication": "headerAuth",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "7a3e0b20-0002-4c00-8000-000000000002",
      "name": "Unpack",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: { ...$input.first().json.body.input, __workflow_id: $input.first().json.body.workflow_id } }];"
      }
    },
    {
      "id": "7a3e0b20-0003-4c00-8000-000000000003",
      "name": "Run Tool",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [440, 300],
      "onError": "continueErrorOutput",
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "={{ $json.__workflow_id }}", "mode": "id" },
        "mode": "once",
        "options": {}
      }
    },
    {
      "id": "7a3e0b20-0004-4c00-8000-000000000004",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [680, 200],
      "parameters": {
        "respondWith": "firstIncomingItem",
        "options": {}
      }
    },
    {
      "id": "7a3e0b20-0005-4c00-8000-000000000005",
      "name": "Respond Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [680, 420],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { verdict: 'HARNESS_ERROR', error: $json.error } }}",
        "options": { "responseCode": 500 }
      }
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Unpack", "type": "main", "index": 0 }]] },
    "Unpack": { "main": [[{ "node": "Run Tool", "type": "main", "index": 0 }]] },
    "Run Tool": {
      "main": [
        [{ "node": "Respond", "type": "main", "index": 0 }],
        [{ "node": "Respond Error", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" }
}
