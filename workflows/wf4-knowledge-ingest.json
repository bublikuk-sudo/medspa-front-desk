{
  "name": "wf4-knowledge-ingest",
  "nodes": [
    {
      "id": "4b0e0016-0001-4c00-8000-000000000001",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 100],
      "parameters": {}
    },
    {
      "id": "4b0e0016-0016-4c00-8000-000000000016",
      "name": "Daily",
      "notes": "Self-repair once a day at 06:35 UTC (07:35 Berlin in winter, 08:35 in summer): one Airtable search; Plan rebuilds only when the index differs from Knowledge. Once a day for the Airtable Free plan (1,000 API calls a month per workspace). After a Knowledge edit, re-index at once with Run Now (scripts/n8n-run.sh wf4-knowledge-ingest); otherwise this run picks the edit up within a day.",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 300],
      "parameters": {
        "rule": {
          "interval": [
            { "field": "days", "daysInterval": 1, "triggerAtHour": 6, "triggerAtMinute": 35 }
          ]
        }
      }
    },
    {
      "id": "4b0e0016-0019-4c00-8000-000000000019",
      "name": "Run Now",
      "notes": "Manual re-index after a Knowledge edit: scripts/n8n-run.sh wf4-knowledge-ingest (POST /webhook/wf4-knowledge-ingest with the MedSpa Test Key header, as WF-5's Run Now). Counts as a manual run in Plan: always rebuilds and tells the owner. Replaces the Airtable trigger that checked Knowledge every 15 minutes (2,880 API calls a month).",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 500],
      "webhookId": "4b0e0016-aaaa-4c00-8000-00000000f004",
      "credentials": {
        "httpHeaderAuth": { "id": "CRED", "name": "MedSpa Test Key" }
      },
      "parameters": {
        "httpMethod": "POST",
        "path": "wf4-knowledge-ingest",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0003-4c00-8000-000000000003",
      "name": "Knowledge",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [240, 300],
      "executeOnce": true,
      "alwaysOutputData": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Knowledge", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0011-4c00-8000-000000000011",
      "name": "Index State",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [460, 300],
      "executeOnce": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT to_regclass('public.medspa_knowledge') IS NOT NULL AS table_exists",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0012-4c00-8000-000000000012",
      "name": "Old Index",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [680, 300],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "={{ $('Index State').first().json.table_exists ? `SELECT metadata->>'kb_id' AS kb_id, text FROM medspa_knowledge` : `SELECT NULL::text AS kb_id, NULL::text AS text WHERE false` }}",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0017-4c00-8000-000000000017",
      "name": "Plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Build the documents, refuse to continue when there are none (BEFORE anything is truncated), and decide whether the index needs rebuilding.\n// One document per Knowledge row: the topic goes on the first line so the embedding sees it; search_knowledge strips that line again. Rows without text are skipped (an empty string cannot be embedded).\nconst documents = $('Knowledge').all()\n  .map(i => i.json.fields || {})\n  .filter(f => String(f.text ?? '').trim() !== '')\n  .map(f => ({ pageContent: f.topic + '\\n' + f.text, kb_id: f.kb_id, topic: f.topic }));\nif (!documents.length) throw new Error('KB_NO_DOCUMENTS: Airtable Knowledge returned no row with text; the index was NOT touched');\n// The index is up to date when it holds exactly the same (kb_id, text) pairs as the documents: nothing missing, nothing duplicated, nothing stale.\nconst key = (id, text) => String(id) + '\\u0000' + String(text);\nconst before = $('Old Index').all().map(i => i.json).filter(r => r.text != null).map(r => key(r.kb_id, r.text)).sort();\nconst after = documents.map(d => key(d.kb_id, d.pageContent)).sort();\nconst upToDate = before.length === after.length && before.every((v, k) => v === after[k]);\n// A manual run (the editor's Manual trigger, or Run Now from scripts/n8n-run.sh) always rebuilds and reports; the Daily run only repairs.\nconst manual = $('Manual').isExecuted || $('Run Now').isExecuted;\nreturn [{ json: { documents, upToDate, manual, rebuild: manual || !upToDate } }];"
      }
    },
    {
      "id": "4b0e0016-0018-4c00-8000-000000000018",
      "name": "Rebuild?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "4b0e0016-1002-4c00-8000-000000000002",
              "leftValue": "={{ $json.rebuild }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0004-4c00-8000-000000000004",
      "name": "Clear Index",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [1340, 240],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "DO $$ BEGIN IF to_regclass('medspa_knowledge') IS NOT NULL THEN TRUNCATE TABLE medspa_knowledge; END IF; END $$;",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0005-4c00-8000-000000000005",
      "name": "Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1560, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return $('Plan').first().json.documents.map(d => ({ json: d }));"
      }
    },
    {
      "id": "4b0e0016-0006-4c00-8000-000000000006",
      "name": "Insert",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [1780, 240],
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "mode": "insert",
        "tableName": "medspa_knowledge",
        "embeddingBatchSize": 200,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0007-4c00-8000-000000000007",
      "name": "Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [1720, 500],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.pageContent }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "kb_id", "value": "={{ $json.kb_id }}" },
              { "name": "topic", "value": "={{ $json.topic }}" }
            ]
          }
        }
      }
    },
    {
      "id": "4b0e0016-0008-4c00-8000-000000000008",
      "name": "Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [1720, 720],
      "parameters": {
        "chunkSize": 800,
        "chunkOverlap": 80,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0009-4c00-8000-000000000009",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [1880, 500],
      "credentials": {
        "openAiApi": { "id": "CRED", "name": "MedSpa OpenAI" }
      },
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0013-4c00-8000-000000000013",
      "name": "Count",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [2000, 240],
      "executeOnce": true,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS n, count(DISTINCT metadata->>'kb_id')::int AS kb, (count(*) - count(DISTINCT (metadata->>'kb_id', text)))::int AS dups FROM medspa_knowledge",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0014-4c00-8000-000000000014",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2220, 240],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Safety net: Clear Index and Insert are not atomic, so a failed Insert leaves the index empty and search_knowledge answers NOT_FOUND to everything. Make every broken state loud with a named error.\n// Count is set to continue on error, so a missing table arrives here as an item without n and counts as empty.\nconst plan = $('Plan').first().json;\nconst c = $input.first().json;\nconst n = Number(c.n ?? 0), kb = Number(c.kb ?? 0), dups = Number(c.dups ?? 0);\nconst expected = new Set(plan.documents.map(d => d.kb_id)).size;\nconst hint = '. Insert is set to continue on error, so its own error message is in the execution data of the Insert node.';\nif (!(n > 0)) throw new Error('KB_INDEX_EMPTY: medspa_knowledge has no rows (or does not exist) after the ingest but Airtable Knowledge gave ' + plan.documents.length + ' documents; search_knowledge answers NOT_FOUND to every question until the next successful ingest' + hint);\nif (dups > 0) throw new Error('KB_INDEX_DUPLICATED: medspa_knowledge has ' + dups + ' duplicate rows (' + n + ' rows in total)' + hint);\nif (kb !== expected) throw new Error('KB_INDEX_INCOMPLETE: medspa_knowledge covers ' + kb + ' of ' + expected + ' paragraphs' + hint);\nconst changed = !plan.upToDate;\nconst text = '📚 Knowledge base re-indexed: ' + plan.documents.length + ' paragraphs' + (changed ? '' : ' (no content changes; manual run)');\nreturn [{ json: { changed, manual: plan.manual, notify: changed || plan.manual, text, rows: n } }];"
      }
    },
    {
      "id": "4b0e0016-0015-4c00-8000-000000000015",
      "name": "Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2440, 240],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "4b0e0016-1001-4c00-8000-000000000001",
              "leftValue": "={{ $json.notify }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0010-4c00-8000-000000000010",
      "name": "Notify",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [2660, 180],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "WFID:notify_owner", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "text": "={{ $json.text }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {}
      }
    }
  ],
  "connections": {
