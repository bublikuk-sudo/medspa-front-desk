{
  "name": "wf4-knowledge-ingest",
  "nodes": [
    {
      "id": "4b0e0016-0001-4c00-8000-000000000001",
      "name": "Manual",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 200],
      "parameters": {}
    },
    {
      "id": "4b0e0016-0002-4c00-8000-000000000002",
      "name": "Knowledge Changed",
      "type": "n8n-nodes-base.airtableTrigger",
      "typeVersion": 1,
      "position": [0, 400],
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "baseId": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "tableId": { "__rl": true, "value": "ATTBL:Knowledge", "mode": "id" },
        "triggerField": "updated_at",
        "downloadAttachments": false,
        "additionalFields": {},
        "pollTimes": {
          "item": [
            { "mode": "everyX", "value": 15, "unit": "minutes" }
          ]
        }
      }
    },
    {
      "id": "4b0e0016-0003-4c00-8000-000000000003",
      "name": "Knowledge",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [240, 300],
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Knowledge", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0004-4c00-8000-000000000004",
      "name": "Clear Index",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [480, 300],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "DO $$ BEGIN IF to_regclass('medspa_knowledge') IS NOT NULL THEN TRUNCATE TABLE medspa_knowledge; END IF; END $$;",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0005-4c00-8000-000000000005",
      "name": "Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One document per Knowledge row: the topic goes on the first line of the text so the embedding sees it; Search strips that line again.\n// Rows without text are skipped (an empty string cannot be embedded).\nreturn $('Knowledge').all()\n  .filter(i => String(i.json.fields?.text ?? '').trim() !== '')\n  .map(i => ({ json: { pageContent: i.json.fields.topic + '\\n' + i.json.fields.text, kb_id: i.json.fields.kb_id, topic: i.json.fields.topic } }));"
      }
    },
    {
      "id": "4b0e0016-0006-4c00-8000-000000000006",
      "name": "Insert",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [960, 300],
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "mode": "insert",
        "tableName": "medspa_knowledge",
        "embeddingBatchSize": 200,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0007-4c00-8000-000000000007",
      "name": "Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [900, 560],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.pageContent }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "kb_id", "value": "={{ $json.kb_id }}" },
              { "name": "topic", "value": "={{ $json.topic }}" }
            ]
          }
        }
      }
    },
    {
      "id": "4b0e0016-0008-4c00-8000-000000000008",
      "name": "Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [900, 780],
      "parameters": {
        "chunkSize": 800,
        "chunkOverlap": 80,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0009-4c00-8000-000000000009",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [1060, 560],
      "credentials": {
        "openAiApi": { "id": "CRED", "name": "MedSpa OpenAI" }
      },
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0010-4c00-8000-000000000010",
      "name": "Notify",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [1200, 300],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "WFID:notify_owner", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "text": "={{ '📚 Knowledge base re-indexed: ' + $('Documents').all().length + ' paragraphs' }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual": { "main": [[{ "node": "Knowledge", "type": "main", "index": 0 }]] },
    "Knowledge Changed": { "main": [[{ "node": "Knowledge", "type": "main", "index": 0 }]] },
    "Knowledge": { "main": [[{ "node": "Clear Index", "type": "main", "index": 0 }]] },
    "Clear Index": { "main": [[{ "node": "Documents", "type": "main", "index": 0 }]] },
    "Documents": { "main": [[{ "node": "Insert", "type": "main", "index": 0 }]] },
    "Insert": { "main": [[{ "node": "Notify", "type": "main", "index": 0 }]] },
    "Loader": { "ai_document": [[{ "node": "Insert", "type": "ai_document", "index": 0 }]] },
    "Splitter": { "ai_textSplitter": [[{ "node": "Loader", "type": "ai_textSplitter", "index": 0 }]] },
    "Embeddings": { "ai_embedding": [[{ "node": "Insert", "type": "ai_embedding", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
