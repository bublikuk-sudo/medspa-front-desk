          ]
        }
      }
    },
    {
      "id": "4b0e0016-0003-4c00-8000-000000000003",
      "name": "Knowledge",
      "type": "n8n-nodes-base.airtable",
      "typeVersion": 2.2,
      "position": [240, 300],
      "executeOnce": true,
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "credentials": {
        "airtableTokenApi": { "id": "CRED", "name": "MedSpa Airtable" }
      },
      "parameters": {
        "authentication": "airtableTokenApi",
        "resource": "record",
        "operation": "search",
        "base": { "__rl": true, "value": "ATBASE", "mode": "id" },
        "table": { "__rl": true, "value": "ATTBL:Knowledge", "mode": "id" },
        "returnAll": true,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0011-4c00-8000-000000000011",
      "name": "Index State",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [460, 300],
      "executeOnce": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT to_regclass('public.medspa_knowledge') IS NOT NULL AS table_exists",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0012-4c00-8000-000000000012",
      "name": "Old Index",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [680, 300],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "={{ $('Index State').first().json.table_exists ? `SELECT metadata->>'kb_id' AS kb_id, text FROM medspa_knowledge` : `SELECT NULL::text AS kb_id, NULL::text AS text WHERE false` }}",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0004-4c00-8000-000000000004",
      "name": "Clear Index",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [900, 300],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "DO $$ BEGIN IF to_regclass('medspa_knowledge') IS NOT NULL THEN TRUNCATE TABLE medspa_knowledge; END IF; END $$;",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0005-4c00-8000-000000000005",
      "name": "Documents",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One document per Knowledge row: the topic goes on the first line of the text so the embedding sees it; Search strips that line again.\n// Rows without text are skipped (an empty string cannot be embedded).\nreturn $('Knowledge').all()\n  .filter(i => String(i.json.fields?.text ?? '').trim() !== '')\n  .map(i => ({ json: { pageContent: i.json.fields.topic + '\\n' + i.json.fields.text, kb_id: i.json.fields.kb_id, topic: i.json.fields.topic } }));"
      }
    },
    {
      "id": "4b0e0016-0006-4c00-8000-000000000006",
      "name": "Insert",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [1340, 300],
      "onError": "continueRegularOutput",
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "mode": "insert",
        "tableName": "medspa_knowledge",
        "embeddingBatchSize": 200,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0007-4c00-8000-000000000007",
      "name": "Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [1280, 560],
      "parameters": {
        "dataType": "json",
        "jsonMode": "expressionData",
        "jsonData": "={{ $json.pageContent }}",
        "textSplittingMode": "custom",
        "options": {
          "metadata": {
            "metadataValues": [
              { "name": "kb_id", "value": "={{ $json.kb_id }}" },
              { "name": "topic", "value": "={{ $json.topic }}" }
            ]
          }
        }
      }
    },
    {
      "id": "4b0e0016-0008-4c00-8000-000000000008",
      "name": "Splitter",
      "type": "@n8n/n8n-nodes-langchain.textSplitterRecursiveCharacterTextSplitter",
      "typeVersion": 1,
      "position": [1280, 780],
      "parameters": {
        "chunkSize": 800,
        "chunkOverlap": 80,
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0009-4c00-8000-000000000009",
      "name": "Embeddings",
      "type": "@n8n/n8n-nodes-langchain.embeddingsOpenAi",
      "typeVersion": 1.2,
      "position": [1440, 560],
      "credentials": {
        "openAiApi": { "id": "CRED", "name": "MedSpa OpenAI" }
      },
      "parameters": {
        "model": "text-embedding-3-small",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0013-4c00-8000-000000000013",
      "name": "Count",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [1560, 300],
      "executeOnce": true,
      "alwaysOutputData": true,
      "credentials": {
        "postgres": { "id": "CRED", "name": "MedSpa Postgres" }
      },
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS n FROM medspa_knowledge",
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0014-4c00-8000-000000000014",
      "name": "Verify",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1780, 300],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Safety net: Clear Index and Insert are not atomic, so a failed Insert leaves the index empty and search_knowledge answers NOT_FOUND to everything. Make that state loud.\nconst docs = $('Documents').all().map(i => i.json);\nconst n = Number($input.first().json.n);\nif (!Number.isFinite(n) || n < docs.length) {\n  const name = n === 0 ? 'KB_INDEX_EMPTY' : 'KB_INDEX_INCOMPLETE';\n  throw new Error(name + ': medspa_knowledge has ' + n + ' rows after the ingest but Airtable Knowledge gave ' + docs.length + ' documents' + (n === 0 ? '; the index is EMPTY and search_knowledge answers NOT_FOUND to every question until the next successful ingest' : '') + '. Insert is set to continue on error, so its own error message is in the execution data of the Insert node.');\n}\n// Did this run change anything? Compare what the index held before Clear Index with what was just inserted.\nconst key = r => String(r.kb_id) + '\\u0000' + String(r.text);\nconst before = $('Old Index').all().map(i => i.json).filter(r => r.text != null).map(key).sort();\nconst after = docs.map(d => key({ kb_id: d.kb_id, text: d.pageContent })).sort();\nconst changed = before.length !== after.length || before.some((v, k) => v !== after[k]);\nconst manual = $('Manual').isExecuted;\nconst text = '📚 Knowledge base re-indexed: ' + docs.length + ' paragraphs' + (changed ? '' : ' (no content changes; manual run)');\nreturn [{ json: { changed, manual, notify: changed || manual, text, rows: n } }];"
      }
    },
    {
      "id": "4b0e0016-0015-4c00-8000-000000000015",
      "name": "Notify?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [2000, 300],
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 3 },
          "conditions": [
            {
              "id": "4b0e0016-1001-4c00-8000-000000000001",
              "leftValue": "={{ $json.notify }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "4b0e0016-0010-4c00-8000-000000000010",
      "name": "Notify",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.4,
      "position": [2220, 240],
      "parameters": {
        "source": "database",
        "workflowId": { "__rl": true, "value": "WFID:notify_owner", "mode": "id" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "text": "={{ $json.text }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "text", "displayName": "text", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true, "type": "string" }
          ],
          "attemptToConvertTypes": false,
          "convertFieldsToString": true
        },
        "mode": "once",
        "options": {}
      }
    }
  ],
  "connections": {
    "Manual": { "main": [[{ "node": "Knowledge", "type": "main", "index": 0 }]] },
    "Knowledge Changed": { "main": [[{ "node": "Knowledge", "type": "main", "index": 0 }]] },
