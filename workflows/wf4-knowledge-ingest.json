    "Verify": { "main": [[{ "node": "Notify?", "type": "main", "index": 0 }]] },
    "Notify?": { "main": [[{ "node": "Notify", "type": "main", "index": 0 }], []] },
    "Loader": { "ai_document": [[{ "node": "Insert", "type": "ai_document", "index": 0 }]] },
    "Splitter": { "ai_textSplitter": [[{ "node": "Loader", "type": "ai_textSplitter", "index": 0 }]] },
    "Embeddings": { "ai_embedding": [[{ "node": "Insert", "type": "ai_embedding", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
